[Unit]
Description=Stempeluhr Professional
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=stempeluhr
Group=stempeluhr
WorkingDirectory=/opt/stempeluhr
Environment=PYTHONPATH=/opt/stempeluhr
EnvironmentFile=-/etc/stempeluhr/stempeluhr.env
ExecStart=/bin/bash -lc 'exec /opt/stempeluhr/.venv/bin/uvicorn app.main:app --host "${HOST:-0.0.0.0}" --port "${PORT:-8000}"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
