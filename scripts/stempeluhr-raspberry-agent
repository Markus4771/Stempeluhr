#!/usr/bin/env python3
"""Stempeluhr Raspberry Agent 5.5.04.

Robuster Chromium-Kiosk-Agent fuer Debian 13/labwc/Wayland und X11.
Der Agent beendet sich nicht mehr, wenn die grafische Sitzung beim Start noch
nicht bereit ist. Fehler werden in Journal und Log protokolliert.
"""
from __future__ import annotations

import argparse
import os
import json
import socket
import platform
import shutil
import signal
import subprocess
import sys
import time
import traceback
from datetime import datetime
from pathlib import Path
from urllib.request import urlopen
try:
    import requests
except Exception:
    requests = None

ENV_FILE = Path('/etc/stempeluhr/raspberry-agent.env')
LOG_FILE_DEFAULT = Path('/var/log/stempeluhr-agent.log')
FALLBACK_LOG_FILE = Path('/tmp/stempeluhr-agent.log')
PID_FILE = Path('/tmp/stempeluhr-raspberry-agent-chromium.pid')

DEFAULTS = {
    'STEMPELUHR_AGENT_ENABLED': '1',
    'STEMPELUHR_KIOSK_URL': 'http://127.0.0.1:8000/raspberry',
    'STEMPELUHR_BROWSER': 'auto',
    'STEMPELUHR_AGENT_INTERVAL': '10',
    'STEMPELUHR_START_DELAY': '8',
    'STEMPELUHR_LOG_FILE': str(LOG_FILE_DEFAULT),
    'STEMPELUHR_CHROME_PROFILE': '~/.config/stempeluhr-chromium-profile',
    'STEMPELUHR_HEARTBEAT_ENABLED': '1',
    'STEMPELUHR_SERVER_BASE': 'http://127.0.0.1:8000',
}
AGENT_VERSION = '5.5.04'


def safe_int(value: str | None, default: int, minimum: int = 0) -> int:
    try:
        return max(int(str(value).strip()), minimum)
    except Exception:
        return default


def read_env() -> dict[str, str]:
    data = dict(DEFAULTS)
    try:
        if ENV_FILE.exists():
            for line in ENV_FILE.read_text(encoding='utf-8', errors='ignore').splitlines():
                line = line.strip()
                if not line or line.startswith('#') or '=' not in line:
                    continue
                key, value = line.split('=', 1)
                data[key.strip()] = value.strip().strip('\"').strip("'")
    except PermissionError as exc:
        # Der Agent darf nie wegen einer falsch gesetzten Dateiberechtigung abstuerzen.
        # Er nutzt dann Defaults und protokolliert den Fehler.
        log(f'WARN: {ENV_FILE} nicht lesbar ({exc}); verwende Standardkonfiguration.', data)
    except Exception as exc:
        log(f'WARN: {ENV_FILE} konnte nicht gelesen werden ({exc}); verwende Standardkonfiguration.', data)
    data.update({k: v for k, v in os.environ.items() if k.startswith('STEMPELUHR_')})
    return data

def log(message: str, env: dict[str, str] | None = None) -> None:
    env = env or DEFAULTS
    line = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}\n"
    path = Path(env.get('STEMPELUHR_LOG_FILE') or LOG_FILE_DEFAULT)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('a', encoding='utf-8') as fh:
            fh.write(line)
    except Exception:
        try:
            with FALLBACK_LOG_FILE.open('a', encoding='utf-8') as fh:
                fh.write(line)
        except Exception:
            pass
    print(line, end='', flush=True)


def find_browser(configured: str | None) -> str | None:
    configured = configured or 'auto'
    if configured != 'auto':
        return configured if Path(configured).exists() or shutil.which(configured) else configured
    for name in ('chromium', 'chromium-browser'):
        found = shutil.which(name)
        if found:
            return found
    for path in ('/usr/bin/chromium', '/usr/bin/chromium-browser'):
        if Path(path).exists():
            return path
    return None


def display_env() -> dict[str, str]:
    env = os.environ.copy()
    uid = os.getuid()
    runtime = Path(f'/run/user/{uid}')
    if not env.get('XDG_RUNTIME_DIR') and runtime.exists():
        env['XDG_RUNTIME_DIR'] = str(runtime)
    xdg = Path(env.get('XDG_RUNTIME_DIR', str(runtime)))
    if not env.get('WAYLAND_DISPLAY'):
        for name in ('wayland-0', 'wayland-1'):
            if (xdg / name).exists():
                env['WAYLAND_DISPLAY'] = name
                break
    if not env.get('DISPLAY'):
        for disp in (':0', ':1'):
            if Path(f'/tmp/.X11-unix/X{disp[1:]}').exists():
                env['DISPLAY'] = disp
                break
    # Häufig bei systemd-user linger: DBUS fehlt. Falls Bus vorhanden, ergänzen.
    if not env.get('DBUS_SESSION_BUS_ADDRESS') and (xdg / 'bus').exists():
        env['DBUS_SESSION_BUS_ADDRESS'] = f'unix:path={xdg / "bus"}'
    return env


def desktop_ready(env: dict[str, str]) -> bool:
    xdg = Path(env.get('XDG_RUNTIME_DIR', ''))
    if env.get('WAYLAND_DISPLAY') and xdg.exists():
        return True
    if env.get('DISPLAY'):
        return True
    return False


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def chromium_running() -> bool:
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            if process_alive(pid):
                return True
        except Exception:
            pass
    try:
        result = subprocess.run(
            ['pgrep', '-f', 'chromium.*(stempeluhr|raspberry)|chromium-browser.*(stempeluhr|raspberry)'],
            capture_output=True,
            text=True,
        )
        return result.returncode == 0 and bool(result.stdout.strip())
    except Exception:
        return False


def url_ok(url: str) -> bool:
    try:
        with urlopen(url, timeout=4) as response:
            return 200 <= int(response.status) < 500
    except Exception:
        return False


def chrome_profile_dir(env_cfg: dict[str, str]) -> str:
    profile = env_cfg.get('STEMPELUHR_CHROME_PROFILE') or DEFAULTS['STEMPELUHR_CHROME_PROFILE']
    profile_path = Path(os.path.expandvars(os.path.expanduser(profile)))
    try:
        profile_path.mkdir(parents=True, exist_ok=True)
    except Exception:
        profile_path = Path('/tmp/stempeluhr-chromium-profile')
        profile_path.mkdir(parents=True, exist_ok=True)
    return str(profile_path)


def start_browser(env_cfg: dict[str, str]) -> bool:
    browser = find_browser(env_cfg.get('STEMPELUHR_BROWSER', 'auto'))
    if not browser:
        log('FEHLER: Chromium wurde nicht gefunden. Bitte chromium installieren.', env_cfg)
        return False
    url = env_cfg.get('STEMPELUHR_KIOSK_URL') or DEFAULTS['STEMPELUHR_KIOSK_URL']
    env = display_env()
    if not desktop_ready(env):
        log('Desktop noch nicht bereit: kein WAYLAND_DISPLAY/DISPLAY gefunden. Warte weiter.', env_cfg)
        return False
    profile_dir = chrome_profile_dir(env_cfg)
    cmd = [
        browser,
        '--kiosk',
        '--noerrdialogs',
        '--disable-infobars',
        '--disable-session-crashed-bubble',
        '--disable-features=TranslateUI',
        '--check-for-update-interval=31536000',
        '--disable-pinch',
        '--overscroll-history-navigation=0',
        '--password-store=basic',
        '--use-mock-keychain',
        '--no-first-run',
        '--no-default-browser-check',
        '--disable-component-update',
        '--disable-dev-shm-usage',
        f'--user-data-dir={profile_dir}',
        url,
    ]
    for xcmd in (['xset', 's', 'off'], ['xset', '-dpms'], ['xset', 's', 'noblank']):
        try:
            subprocess.run(xcmd, env=env, timeout=2, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
    try:
        proc = subprocess.Popen(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        PID_FILE.write_text(str(proc.pid), encoding='utf-8')
        log(f'Chromium gestartet PID={proc.pid} URL={url} Profile={profile_dir} Keyring=deaktiviert', env_cfg)
        return True
    except Exception as exc:
        log(f'FEHLER beim Chromium-Start: {exc}', env_cfg)
        return False



def server_base(env_cfg: dict[str, str]) -> str:
    base = env_cfg.get('STEMPELUHR_SERVER_BASE') or ''
    if base:
        return base.rstrip('/')
    url = env_cfg.get('STEMPELUHR_KIOSK_URL') or DEFAULTS['STEMPELUHR_KIOSK_URL']
    if '/raspberry' in url:
        return url.split('/raspberry', 1)[0].rstrip('/')
    return 'http://127.0.0.1:8000'


def _read_file(path: str, default: str = '') -> str:
    try:
        return Path(path).read_text(errors='ignore').strip()
    except Exception:
        return default


def _ram_percent() -> float:
    try:
        data = {}
        for line in Path('/proc/meminfo').read_text().splitlines():
            k, v = line.split(':', 1)
            data[k] = float(v.strip().split()[0])
        total = data.get('MemTotal', 0)
        available = data.get('MemAvailable', 0)
        if total:
            return round((total - available) / total * 100, 1)
    except Exception:
        pass
    return 0.0


def _cpu_percent() -> float:
    try:
        load1 = os.getloadavg()[0]
        cpus = os.cpu_count() or 1
        return round(min(100.0, (load1 / cpus) * 100.0), 1)
    except Exception:
        return 0.0


def _temperature() -> str:
    raw = _read_file('/sys/class/thermal/thermal_zone0/temp')
    try:
        return f"{float(raw)/1000:.1f} °C"
    except Exception:
        return ''


def _uptime() -> str:
    try:
        seconds = int(float(Path('/proc/uptime').read_text().split()[0]))
        days, rem = divmod(seconds, 86400)
        hours, rem = divmod(rem, 3600)
        minutes, _ = divmod(rem, 60)
        if days:
            return f'{days}d {hours}h {minutes}m'
        return f'{hours}h {minutes}m'
    except Exception:
        return ''


def make_screenshot(env_cfg: dict[str, str]) -> str | None:
    env = display_env()
    target = Path('/tmp/stempeluhr-kiosk.png')
    try:
        if target.exists():
            target.unlink()
    except Exception:
        pass
    commands = []
    # Wayland/labwc: grim ist die zuverlaessigste Variante.
    if shutil.which('grim'):
        commands.append(['grim', str(target)])
    # X11-Fallback.
    if shutil.which('scrot'):
        commands.append(['scrot', str(target)])
    if not commands:
        log('Screenshot nicht möglich: weder grim noch scrot installiert.', env_cfg)
        return None
    last_error = ''
    for cmd in commands:
        try:
            result = subprocess.run(cmd, env=env, timeout=10, check=False, capture_output=True, text=True)
            if result.returncode == 0 and target.exists() and target.stat().st_size > 0:
                log(f'Screenshot erstellt mit {cmd[0]}: {target} ({target.stat().st_size} Bytes)', env_cfg)
                return str(target)
            last_error = (result.stderr or result.stdout or f'Exitcode {result.returncode}').strip()
            log(f'Screenshot mit {cmd[0]} fehlgeschlagen: {last_error}', env_cfg)
        except Exception as exc:
            last_error = str(exc)
            log(f'Screenshot mit {cmd[0]} fehlgeschlagen: {exc}', env_cfg)
    log('Screenshot nicht möglich: Desktop nicht erreichbar oder Screenshot-Tool fehlgeschlagen. ' + last_error, env_cfg)
    return None


def send_command_result(env_cfg: dict[str, str], command: str, message: str) -> None:
    if not requests:
        log(f'Command-Result nicht möglich: {message}', env_cfg)
        return
    try:
        url = server_base(env_cfg) + '/api/v1/raspberry/command-result'
        payload = {'hostname': socket.gethostname(), 'command': command, 'result': message}
        r = requests.post(url, json=payload, timeout=8)
        log(f'Command-Result HTTP {r.status_code}: {message}', env_cfg)
    except Exception as exc:
        log(f'Command-Result fehlgeschlagen: {exc}', env_cfg)


def upload_screenshot(env_cfg: dict[str, str], path: str) -> bool:
    if not requests:
        log('Screenshot-Upload nicht möglich: Python-Modul requests fehlt.', env_cfg)
        return False
    try:
        url = server_base(env_cfg) + '/api/v1/raspberry/screenshot'
        with open(path, 'rb') as fh:
            r = requests.post(url, data={'hostname': socket.gethostname()}, files={'file': ('kiosk.png', fh, 'image/png')}, timeout=15)
        log(f'Screenshot-Upload HTTP {r.status_code}: {r.text[:200]}', env_cfg)
        return bool(r.ok)
    except Exception as exc:
        log(f'Screenshot-Upload fehlgeschlagen: {exc}', env_cfg)
        return False


def execute_command(command: str | None, env_cfg: dict[str, str]) -> None:
    if not command:
        return
    log(f'Empfangener Raspberry-Befehl: {command}', env_cfg)
    if command == 'restart_chromium':
        subprocess.run(['pkill', '-f', 'chromium.*(stempeluhr|raspberry)|chromium-browser.*(stempeluhr|raspberry)'], check=False)
        time.sleep(2)
        ok = start_browser(env_cfg)
        send_command_result(env_cfg, command, 'Chromium neu gestartet' if ok else 'Chromium-Neustart fehlgeschlagen')
    elif command == 'clear_cache':
        profile = Path(chrome_profile_dir(env_cfg))
        for sub in ('Cache', 'Code Cache', 'GPUCache'):
            shutil.rmtree(profile / sub, ignore_errors=True)
        subprocess.run(['pkill', '-f', 'chromium.*(stempeluhr|raspberry)|chromium-browser.*(stempeluhr|raspberry)'], check=False)
        time.sleep(2)
        ok = start_browser(env_cfg)
        send_command_result(env_cfg, command, 'Cache geloescht und Chromium neu gestartet' if ok else 'Cache geloescht, Chromium-Neustart fehlgeschlagen')
    elif command == 'screenshot':
        path = make_screenshot(env_cfg)
        if path and upload_screenshot(env_cfg, path):
            send_command_result(env_cfg, command, 'Bildschirmfoto aktualisiert')
        else:
            send_command_result(env_cfg, command, 'Bildschirmfoto fehlgeschlagen: grim/scrot oder Desktop-Sitzung pruefen')


def send_heartbeat(env_cfg: dict[str, str]) -> None:
    if env_cfg.get('STEMPELUHR_HEARTBEAT_ENABLED', '1').lower() not in ('1', 'true', 'yes', 'on', 'ja'):
        return
    if not requests:
        return
    env = display_env()
    payload = {
        'hostname': socket.gethostname(),
        'ip_address': '',
        'agent_version': AGENT_VERSION,
        'app_version': '5.5.04',
        'debian_version': platform.platform(),
        'chromium_running': chromium_running(),
        'kiosk_url': env_cfg.get('STEMPELUHR_KIOSK_URL') or DEFAULTS['STEMPELUHR_KIOSK_URL'],
        'fullscreen': chromium_running(),
        'wayland_display': env.get('WAYLAND_DISPLAY', ''),
        'display': env.get('DISPLAY', ''),
        'cpu_percent': _cpu_percent(),
        'ram_percent': _ram_percent(),
        'temperature': _temperature(),
        'uptime': _uptime(),
        'last_log': '',
    }
    try:
        url = server_base(env_cfg) + '/api/v1/raspberry/heartbeat'
        r = requests.post(url, json=payload, timeout=5)
        if r.ok:
            command = (r.json() or {}).get('command')
            execute_command(command, env_cfg)
    except Exception as exc:
        log(f'Heartbeat fehlgeschlagen: {exc}', env_cfg)


def run_once(env_cfg: dict[str, str]) -> int:
    if env_cfg.get('STEMPELUHR_AGENT_ENABLED', '1').lower() not in ('1', 'true', 'yes', 'on', 'ja'):
        log('Agent deaktiviert.', env_cfg)
        return 0
    if chromium_running():
        log('Chromium laeuft bereits.', env_cfg)
        return 0
    return 0 if start_browser(env_cfg) else 1


def daemon() -> int:
    env_cfg = read_env()
    delay = safe_int(env_cfg.get('STEMPELUHR_START_DELAY'), 8, 0)
    interval = safe_int(env_cfg.get('STEMPELUHR_AGENT_INTERVAL'), 10, 5)
    log(f'Stempeluhr Raspberry Agent gestartet. Delay={delay}s Intervall={interval}s', env_cfg)
    time.sleep(delay)
    while True:
        try:
            env_cfg = read_env()
            if env_cfg.get('STEMPELUHR_AGENT_ENABLED', '1').lower() in ('1', 'true', 'yes', 'on', 'ja'):
                if not chromium_running():
                    start_browser(env_cfg)
                send_heartbeat(env_cfg)
        except Exception:
            log('FEHLER im Agent-Loop:\n' + traceback.format_exc(), env_cfg if 'env_cfg' in locals() else DEFAULTS)
        time.sleep(interval)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument('--once', action='store_true', help='Nur einmal starten/pruefen')
    parser.add_argument('--status', action='store_true', help='Status anzeigen')
    args = parser.parse_args()
    env_cfg = read_env()
    if args.status:
        print('enabled=', env_cfg.get('STEMPELUHR_AGENT_ENABLED'))
        print('url=', env_cfg.get('STEMPELUHR_KIOSK_URL'))
        print('running=', chromium_running())
        print('display_env=', {k: display_env().get(k) for k in ('XDG_RUNTIME_DIR','WAYLAND_DISPLAY','DISPLAY','DBUS_SESSION_BUS_ADDRESS')})
        print('chrome_profile=', chrome_profile_dir(env_cfg))
        print('browser=', find_browser(env_cfg.get('STEMPELUHR_BROWSER', 'auto')))
        print('keyring_flags= --password-store=basic --use-mock-keychain')
        return 0
    if args.once:
        return run_once(env_cfg)
    return daemon()


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise
    except Exception:
        log('FATALER AGENT-FEHLER:\n' + traceback.format_exc(), DEFAULTS)
        # Nicht hart scheitern lassen, damit systemd nicht in eine Restart-Schleife läuft.
        time.sleep(10)
        raise SystemExit(0)
