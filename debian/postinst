#!/usr/bin/env bash
set -Eeuo pipefail

APP_USER="stempeluhr"
APP_GROUP="stempeluhr"
APP_DIR="/opt/stempeluhr"
CONFIG_DIR="/etc/stempeluhr"
ENV_FILE="$CONFIG_DIR/stempeluhr.env"
SECRETS_DIR="$CONFIG_DIR/secrets"
DB_SECRET_FILE="$SECRETS_DIR/database.conf"
DATA_DIR="/var/lib/stempeluhr"
TMP_DIR="$DATA_DIR/tmp"
LOG_DIR="/var/log/stempeluhr"
HELPER="/usr/local/sbin/stempeluhr-database-secret-helper"
MAIN_UPDATE_HELPER="/usr/local/sbin/stempeluhr-github-main-update"
NEW_CONFIG=0

log(){ printf '[stempeluhr-postinst] %s\n' "$*"; }

getent group "$APP_GROUP" >/dev/null 2>&1 || addgroup --system "$APP_GROUP"
id "$APP_USER" >/dev/null 2>&1 || adduser --system --ingroup "$APP_GROUP" --home "$APP_DIR" --no-create-home --shell /usr/sbin/nologin "$APP_USER"

install -d -m 0755 -o "$APP_USER" -g "$APP_GROUP" "$APP_DIR"
install -d -m 0750 -o "$APP_USER" -g "$APP_GROUP" "$DATA_DIR" "$TMP_DIR" "$LOG_DIR"
install -d -m 0750 -o root -g "$APP_GROUP" "$CONFIG_DIR"
install -d -m 0770 -o root -g "$APP_GROUP" "$SECRETS_DIR"

if [[ ! -f "$ENV_FILE" ]]; then
  NEW_CONFIG=1
  DB_PASSWORD="$(openssl rand -hex 24)"
  cat > "$ENV_FILE" <<EOF
DATABASE_TYPE=postgresql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=stempeluhr
DATABASE_USER=stempeluhr
HOST=0.0.0.0
PORT=8000
EOF
  printf 'DATABASE_PASSWORD=%s\n' "$DB_PASSWORD" > "$DB_SECRET_FILE"
  log "Neue Grundkonfiguration und geschützte Datenbank-Secret-Datei erzeugt."
else
  log "Vorhandene Konfiguration bleibt erhalten."
  if [[ ! -f "$DB_SECRET_FILE" ]]; then
    OLD_PASSWORD="$(sed -n 's/^DATABASE_PASSWORD=//p' "$ENV_FILE" | tail -n1)"
    if [[ -n "$OLD_PASSWORD" ]]; then
      printf 'DATABASE_PASSWORD=%s\n' "$OLD_PASSWORD" > "$DB_SECRET_FILE"
      sed -i '/^DATABASE_PASSWORD=/d' "$ENV_FILE"
      log "Vorhandenes Datenbankpasswort in Secret-Datei migriert."
    fi
  fi
fi

chown root:"$APP_GROUP" "$ENV_FILE"
chmod 0640 "$ENV_FILE"
if [[ -f "$DB_SECRET_FILE" ]]; then chown root:"$APP_GROUP" "$DB_SECRET_FILE"; chmod 0640 "$DB_SECRET_FILE"; fi
if [[ -f "$SECRETS_DIR/github_token" ]]; then chown "$APP_USER":"$APP_GROUP" "$SECRETS_DIR/github_token"; chmod 0600 "$SECRETS_DIR/github_token"; fi

set -a
. "$ENV_FILE"
[[ ! -f "$DB_SECRET_FILE" ]] || . "$DB_SECRET_FILE"
set +a
DATABASE_NAME="${DATABASE_NAME:-stempeluhr}"
DATABASE_USER="${DATABASE_USER:-stempeluhr}"
DATABASE_PASSWORD="${DATABASE_PASSWORD:-}"
DATABASE_HOST="${DATABASE_HOST:-127.0.0.1}"
DATABASE_PORT="${DATABASE_PORT:-5432}"
[[ "$DATABASE_USER" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "Ungültiger DATABASE_USER" >&2; exit 1; }
[[ "$DATABASE_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "Ungültiger DATABASE_NAME" >&2; exit 1; }

if [[ "$DATABASE_HOST" == "127.0.0.1" || "$DATABASE_HOST" == "localhost" ]]; then
  if command -v psql >/dev/null 2>&1 && id postgres >/dev/null 2>&1; then
    ROLE_EXISTS="$(runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='$DATABASE_USER'" postgres || true)"
    DB_EXISTS="$(runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_database WHERE datname='$DATABASE_NAME'" postgres || true)"
    if [[ "$ROLE_EXISTS" != "1" ]]; then
      [[ -n "$DATABASE_PASSWORD" ]] || { echo "Datenbankpasswort fehlt." >&2; exit 1; }
      SQL_PASSWORD="${DATABASE_PASSWORD//\'/\'\'}"
      runuser -u postgres -- psql -v ON_ERROR_STOP=1 postgres -c "SET password_encryption='scram-sha-256'; CREATE ROLE \"$DATABASE_USER\" LOGIN PASSWORD '$SQL_PASSWORD';"
    elif [[ "$NEW_CONFIG" == "1" ]]; then
      SQL_PASSWORD="${DATABASE_PASSWORD//\'/\'\'}"
      runuser -u postgres -- psql -v ON_ERROR_STOP=1 postgres -c "SET password_encryption='scram-sha-256'; ALTER ROLE \"$DATABASE_USER\" WITH LOGIN PASSWORD '$SQL_PASSWORD';"
    fi
    [[ "$DB_EXISTS" == "1" ]] || runuser -u postgres -- createdb --owner="$DATABASE_USER" "$DATABASE_NAME"
    runuser -u postgres -- psql -v ON_ERROR_STOP=1 "$DATABASE_NAME" -c "GRANT ALL ON SCHEMA public TO \"$DATABASE_USER\";"
  fi
fi

python3 -m venv "$APP_DIR/.venv"
"$APP_DIR/.venv/bin/python" -m pip install --disable-pip-version-check --upgrade pip setuptools wheel
"$APP_DIR/.venv/bin/python" -m pip install --disable-pip-version-check -r "$APP_DIR/requirements.txt"

install -m 0750 -o root -g root "$APP_DIR/scripts/database_secret_helper.py" "$HELPER"
install -m 0750 -o root -g root "$APP_DIR/scripts/github_main_update_runner.sh" "$MAIN_UPDATE_HELPER"
cat > /etc/sudoers.d/stempeluhr-database-secret <<EOF
$APP_USER ALL=(root) NOPASSWD: $HELPER $TMP_DIR/database-secret-*.json
EOF
cat > /etc/sudoers.d/stempeluhr-github-main-update <<EOF
$APP_USER ALL=(root) NOPASSWD: $MAIN_UPDATE_HELPER
EOF
chmod 0440 /etc/sudoers.d/stempeluhr-database-secret /etc/sudoers.d/stempeluhr-github-main-update
visudo -cf /etc/sudoers.d/stempeluhr-database-secret >/dev/null
visudo -cf /etc/sudoers.d/stempeluhr-github-main-update >/dev/null

chown -R "$APP_USER:$APP_GROUP" "$APP_DIR"
chown "$APP_USER:$APP_GROUP" "$TMP_DIR"
chmod 0750 "$TMP_DIR"
cd "$APP_DIR"
runuser -u "$APP_USER" -- env HOME="$APP_DIR" USER="$APP_USER" LOGNAME="$APP_USER" PGSSLMODE="disable" "$APP_DIR/.venv/bin/python" -c 'from app.init_db import init_db; init_db()'
systemctl daemon-reload
systemctl enable stempeluhr.service >/dev/null
systemctl restart stempeluhr.service
log "Installation beziehungsweise Update abgeschlossen."
