[Unit]
Description=Stempeluhr Raspberry RFID/NFC Agent
After=network-online.target stempeluhr.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/stempeluhr/rfid-agent.env
ExecStart=/usr/bin/python3 /opt/stempeluhr/scripts/raspberry_rfid_agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/stempeluhr /var/lib/stempeluhr

[Install]
WantedBy=multi-user.target
